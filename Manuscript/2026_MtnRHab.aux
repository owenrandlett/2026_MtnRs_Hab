\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Zebrafish mutants for \emph  {mtnr1aa} and \emph  {mtnr1al}, but not \emph  {mtnr1ab}, are less sensitive to Melatonin's effects on habituation learning}  Habituation behaviour comparing mutants for \emph  {mtnr1aa} (\textbf  {A-F}; 9 different plates: DMSO \emph  {mtnr1aa\textsuperscript  {+/?}} n~=~394, Melatonin \emph  {mtnr1aa\textsuperscript  {+/?}} n~=~1169, DMSO \emph  {mtnr1aa\textsuperscript  {-/-}} n~=~149, Melatonin \emph  {mtnr1aa\textsuperscript  {-/-}} n~=~305), \emph  {mtnr1ab} (\textbf  {G-L}; 2 different plates: DMSO \emph  {mtnr1ab\textsuperscript  {+/?}} n~=~37, Melatonin \emph  {mtnr1ab\textsuperscript  {+/?}} n~=~115, DMSO \emph  {mtnr1ab\textsuperscript  {-/-}} n~=~10, Melatonin \emph  {mtnr1ab\textsuperscript  {-/-}} n~=~42), and \emph  {mtnr1al} (\textbf  {M-R}; 4 different plates: DMSO \emph  {mtnr1al\textsuperscript  {+/?}} n~=~108, Melatonin \emph  {mtnr1al\textsuperscript  {+/?}} n~=~467, DMSO \emph  {mtnr1al\textsuperscript  {-/-}} n~=~64, Melatonin \emph  {mtnr1al\textsuperscript  {-/-}} n~=~211) to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro  \Molar } Melatonin, or vehicle (0.1\% DMSO). DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1 hour of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf  {i}). Each dot is the mean response across larvae to each DF, while 'X's mark mean responses to vibration stimuli. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components:   \textbf  {A), G), M)} the probability of response to the stimulus:   \textbf  {B), H), N)} the response latency,   \textbf  {C), I), O)} the maximum tail-bend amplitude achieved during the movement,   \textbf  {D), J), P)} the duration of the movement,   \textbf  {E), K), Q)} the displacement of the movement, and   \textbf  {F), L), R)} the reorientation achieved by the larvae.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:3}{{3}{7}{\textbf {Zebrafish mutants for \emph {mtnr1aa} and \emph {mtnr1al}, but not \emph {mtnr1ab}, are less sensitive to Melatonin's effects on habituation learning}\\ Habituation behaviour comparing mutants for \emph {mtnr1aa} (\textbf {A-F}; 9 different plates: DMSO \emph {mtnr1aa\textsuperscript {+/?}} n~=~394, Melatonin \emph {mtnr1aa\textsuperscript {+/?}} n~=~1169, DMSO \emph {mtnr1aa\textsuperscript {-/-}} n~=~149, Melatonin \emph {mtnr1aa\textsuperscript {-/-}} n~=~305), \emph {mtnr1ab} (\textbf {G-L}; 2 different plates: DMSO \emph {mtnr1ab\textsuperscript {+/?}} n~=~37, Melatonin \emph {mtnr1ab\textsuperscript {+/?}} n~=~115, DMSO \emph {mtnr1ab\textsuperscript {-/-}} n~=~10, Melatonin \emph {mtnr1ab\textsuperscript {-/-}} n~=~42), and \emph {mtnr1al} (\textbf {M-R}; 4 different plates: DMSO \emph {mtnr1al\textsuperscript {+/?}} n~=~108, Melatonin \emph {mtnr1al\textsuperscript {+/?}} n~=~467, DMSO \emph {mtnr1al\textsuperscript {-/-}} n~=~64, Melatonin \emph {mtnr1al\textsuperscript {-/-}} n~=~211) to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro \Molar } Melatonin, or vehicle (0.1\% DMSO). DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1 hour of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf {i}). Each dot is the mean response across larvae to each DF, while 'X's mark mean responses to vibration stimuli. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components: \\ \textbf {A), G), M)} the probability of response to the stimulus: \\ \textbf {B), H), N)} the response latency, \\ \textbf {C), I), O)} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {D), J), P)} the duration of the movement, \\ \textbf {E), K), Q)} the displacement of the movement, and \\ \textbf {F), L), R)} the reorientation achieved by the larvae}{figure.caption.10}{}}
\newlabel{fig:S3}{{S3}{7}{\textbf {Zebrafish mutants for \emph {mtnr1aa} and \emph {mtnr1al}, but not \emph {mtnr1ab}, are less sensitive to Melatonin's effects on habituation learning}\\ Habituation behaviour comparing mutants for \emph {mtnr1aa} (\textbf {A-F}; 9 different plates: DMSO \emph {mtnr1aa\textsuperscript {+/?}} n~=~394, Melatonin \emph {mtnr1aa\textsuperscript {+/?}} n~=~1169, DMSO \emph {mtnr1aa\textsuperscript {-/-}} n~=~149, Melatonin \emph {mtnr1aa\textsuperscript {-/-}} n~=~305), \emph {mtnr1ab} (\textbf {G-L}; 2 different plates: DMSO \emph {mtnr1ab\textsuperscript {+/?}} n~=~37, Melatonin \emph {mtnr1ab\textsuperscript {+/?}} n~=~115, DMSO \emph {mtnr1ab\textsuperscript {-/-}} n~=~10, Melatonin \emph {mtnr1ab\textsuperscript {-/-}} n~=~42), and \emph {mtnr1al} (\textbf {M-R}; 4 different plates: DMSO \emph {mtnr1al\textsuperscript {+/?}} n~=~108, Melatonin \emph {mtnr1al\textsuperscript {+/?}} n~=~467, DMSO \emph {mtnr1al\textsuperscript {-/-}} n~=~64, Melatonin \emph {mtnr1al\textsuperscript {-/-}} n~=~211) to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro \Molar } Melatonin, or vehicle (0.1\% DMSO). DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1 hour of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf {i}). Each dot is the mean response across larvae to each DF, while 'X's mark mean responses to vibration stimuli. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components: \\ \textbf {A), G), M)} the probability of response to the stimulus: \\ \textbf {B), H), N)} the response latency, \\ \textbf {C), I), O)} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {D), J), P)} the duration of the movement, \\ \textbf {E), K), Q)} the displacement of the movement, and \\ \textbf {F), L), R)} the reorientation achieved by the larvae}{figsupp.11}{}}
