\@writefile{toc}{\contentsline {subsection}{Melatonin induces bidirectional changes in visual habituation learning}{1}{subsection*.4}\protected@file@percent }
\citation{Lamire2023-he}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Melatonin has bidirectional effects on different components of habituation learning}  \textbf  {A)} Treatment with \SI {1}{\micro  \Molar } Melatonin (red) results in more rapid and profound decreases in the Probability of response to DF stimuli during habituation training relative to vehicle controls (0.1\% DMSO black). DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf  {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Quantification of the average.   \textbf  {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001. \textbf  {B-F)} Same as A, but for the kinematic components of the O-bend response:   \textbf  {B} the response latency,   \textbf  {C} the maximum tail-bend amplitude achieved during the movement,   \textbf  {D} the duration of the movement,   \textbf  {E} the displacement as achieved, and   \textbf  {F} the reorientation achieved by the larvae. }}{2}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:1}{{1}{2}{\textbf {Melatonin has bidirectional effects on different components of habituation learning}\\ \textbf {A)} Treatment with \SI {1}{\micro \Molar } Melatonin (red) results in more rapid and profound decreases in the Probability of response to DF stimuli during habituation training relative to vehicle controls (0.1\% DMSO black). DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Quantification of the average. \\ \textbf {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001. \textbf {B-F)} Same as A, but for the kinematic components of the O-bend response: \\ \textbf {B} the response latency, \\ \textbf {C} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {D} the duration of the movement, \\ \textbf {E} the displacement as achieved, and \\ \textbf {F} the reorientation achieved by the larvae}{figure.caption.5}{}}
\citation{Gandhi2015_NEURON,Hill2026}
\@writefile{toc}{\contentsline {subsection}{Zebrafish larvae lacking Melatonin production show habituation deficits for the Probability of response}{3}{subsection*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Zebrafish larvae lacking Melatonin production show habituation deficits for the probability of response}  \textbf  {A)} Double mutants for the melatonin-synthesizing enzymes Aanat1 and Aanat2 show a decreased modulation of the Probability of response to DF stimuli during habituation training relative to heterozygous and WT sibling controls. Testing was performed during the circadian day, beginning at approximately ZT4, where ZT0 is entrained time of lights on and ZT12 is the time of lights off. DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf  {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2).   \textbf  {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001. \textbf  {B-F)} Same as A, but for the kinematic components of the O-bend response:   \textbf  {B} the response latency,   \textbf  {C} the maximum tail-bend amplitude achieved during the movement,   \textbf  {D} the duration of the movement,   \textbf  {E} the displacement as achieved, and   \textbf  {F} the reorientation achieved by the larvae. \textbf  {G)} Double mutants for the melatonin-synthesizing enzymes Aanat1 and Aanat2 show a decreased modulation of the Probability of response to DF stimuli during habituation training relative to heterozygous and WT sibling controls. \textbf  {H-L)} Same as G, but for the kinematic components of the O-bend response:   \textbf  {H} the response latency,   \textbf  {I} the maximum tail-bend amplitude achieved during the movement,   \textbf  {J} the duration of the movement,   \textbf  {K} the displacement as achieved, and   \textbf  {L} the reorientation achieved by the larvae. }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:2}{{2}{4}{\textbf {Zebrafish larvae lacking Melatonin production show habituation deficits for the probability of response}\\ \textbf {A)} Double mutants for the melatonin-synthesizing enzymes Aanat1 and Aanat2 show a decreased modulation of the Probability of response to DF stimuli during habituation training relative to heterozygous and WT sibling controls. Testing was performed during the circadian day, beginning at approximately ZT4, where ZT0 is entrained time of lights on and ZT12 is the time of lights off. DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). \\ \textbf {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001. \textbf {B-F)} Same as A, but for the kinematic components of the O-bend response: \\ \textbf {B} the response latency, \\ \textbf {C} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {D} the duration of the movement, \\ \textbf {E} the displacement as achieved, and \\ \textbf {F} the reorientation achieved by the larvae. \textbf {G)} Double mutants for the melatonin-synthesizing enzymes Aanat1 and Aanat2 show a decreased modulation of the Probability of response to DF stimuli during habituation training relative to heterozygous and WT sibling controls. \textbf {H-L)} Same as G, but for the kinematic components of the O-bend response: \\ \textbf {H} the response latency, \\ \textbf {I} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {J} the duration of the movement, \\ \textbf {K} the displacement as achieved, and \\ \textbf {L} the reorientation achieved by the larvae}{figure.caption.7}{}}
