\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Zebrafish mutants for \emph  {mtnr1ba}, \emph  {mtnr1bb}, and \emph  {mtnr1c} show normal responsiveness to Melatonin's effects on habituation learning}  Habituation behaviour comparing mutants for \emph  {mtnr1ba} (\textbf  {A-F}), and \emph  {mtnr1bb} (\textbf  {G-L}), and \emph  {mtnr1c} (\textbf  {M-R}) to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro  \Molar } Melatonin, or vehicle (0.1DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf  {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components:   \textbf  {A, G, M} the probability of response to the stimulus:   \textbf  {B, H, N} the response latency,   \textbf  {C, I, O} the maximum tail-bend amplitude achieved during the movement,   \textbf  {D, J, P} the duration of the movement,   \textbf  {E, K, Q} the displacement as achieved, and   \textbf  {F, L, R} the reorientation achieved by the larvae.   \textbf  {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001. }}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:4}{{4}{8}{\textbf {Zebrafish mutants for \emph {mtnr1ba}, \emph {mtnr1bb}, and \emph {mtnr1c} show normal responsiveness to Melatonin's effects on habituation learning}\\ Habituation behaviour comparing mutants for \emph {mtnr1ba} (\textbf {A-F}), and \emph {mtnr1bb} (\textbf {G-L}), and \emph {mtnr1c} (\textbf {M-R}) to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro \Molar } Melatonin, or vehicle (0.1DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components: \\ \textbf {A, G, M} the probability of response to the stimulus: \\ \textbf {B, H, N} the response latency, \\ \textbf {C, I, O} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {D, J, P} the duration of the movement, \\ \textbf {E, K, Q} the displacement as achieved, and \\ \textbf {F, L, R} the reorientation achieved by the larvae. \\ \textbf {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Zebrafish larvae lacking both \emph  {mtnr1aa} and \emph  {mtnr1al} are insensitive to Melatonin's effects on habituation learning}  Habituation behaviour comparing double mutants for \emph  {mtnr1aa} and \emph  {mtnr1al} to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro  \Molar } Melatonin, or vehicle (0.1DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf  {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components:   \textbf  {A} the probability of response to the stimulus:   \textbf  {B} the response latency,   \textbf  {C} the maximum tail-bend amplitude achieved during the movement,   \textbf  {D} the duration of the movement,   \textbf  {E} the displacement as achieved, and   \textbf  {F} the reorientation achieved by the larvae.   \textbf  {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001. }}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:5}{{5}{9}{\textbf {Zebrafish larvae lacking both \emph {mtnr1aa} and \emph {mtnr1al} are insensitive to Melatonin's effects on habituation learning}\\ Habituation behaviour comparing double mutants for \emph {mtnr1aa} and \emph {mtnr1al} to their WT and heterozygous sibling controls. Larvae are treated with either \SI {1}{\micro \Molar } Melatonin, or vehicle (0.1DF stimuli are delivered at 1-minute intervals, in 4 blocks of 60 stimuli, separated by 1hr of rest (from 0:00-7:00). 1.5 hours later a block of 30 vibration stimuli are delivered at 1-minute intervals (\textbf {i}). Each dot is the probability of response to one DF. Lines are smoothed in time with a Savitzky–Golay filter (window = 15 stimuli, order = 2). Data is shown for the following behavioural components: \\ \textbf {A} the probability of response to the stimulus: \\ \textbf {B} the response latency, \\ \textbf {C} the maximum tail-bend amplitude achieved during the movement, \\ \textbf {D} the duration of the movement, \\ \textbf {E} the displacement as achieved, and \\ \textbf {F} the reorientation achieved by the larvae. \\ \textbf {ii)-v)} Distributions responsiveness for different epochs of the experiment. Each dot is the per-fish average of the epoch. Statistical significance was calculated using the Kruskal-Wallis test followed by Dunn's test for post-hoc pairwise comparisons, * = p < 0.05, ** = p < 0.01, *** = p < 0.001}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Differential activity of \emph  {mtnr1aa} and \emph  {mtnr1al} in response to dark flash training}   \textbf  {A)} Fluorescent \emph  {in situ} hybridization for \emph  {mtnr1aa} in the brain of 5dpf larval zebrafish. 3 planes of the brain are shown moving from dorsal (top) to ventral (bottom). Tec = Tectum, Cb = Cerebellum, Teg = Tegmentum, POA = Preoptic Area, PT = Posterior Tuberculum, mHB = Medial Hindbrain. }}{9}{figure.caption.16}\protected@file@percent }
